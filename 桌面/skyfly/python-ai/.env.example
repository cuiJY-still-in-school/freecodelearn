# SkyFly AI Service Configuration
# 复制此文件为 .env 并填入你的API密钥

# === 国际主流模型 ===

# OpenAI (GPT-4o / GPT-4 / GPT-3.5)
OPENAI_API_KEY=sk-your-openai-key-here

# Anthropic Claude (Claude 3.5 Sonnet / Claude 3 Opus)
ANTHROPIC_API_KEY=sk-ant-your-claude-key-here

# Google Gemini (Gemini 1.5 Pro / Flash)
GOOGLE_API_KEY=your-google-api-key-here

# Together AI (Meta Llama 3.1)
TOGETHER_API_KEY=your-together-key-here

# Mistral AI (Mistral Large / Codestral)
MISTRAL_API_KEY=your-mistral-key-here

# === 中国主流模型 ===

# DeepSeek (V3 / Coder) - 性价比最高
# https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# Kimi (Moonshot AI)
# https://platform.moonshot.cn/
KIMI_API_KEY=sk-your-kimi-key-here

# 通义千问 (阿里云)
# https://dashscope.aliyun.com/
QWEN_API_KEY=sk-your-qwen-key-here

# 文心一言 ERNIE (百度)
# https://cloud.baidu.com/product/ernie
ERNIE_API_KEY=your-ernie-api-key-here
ERNIE_SECRET_KEY=your-ernie-secret-key-here

# 智谱 GLM
# https://open.bigmodel.cn/
ZHIPU_API_KEY=your-zhipu-api-key-here

# === 自定义API ===
# 支持任何兼容 OpenAI API 格式的服务
CUSTOM_API_KEY=your-custom-api-key-here
CUSTOM_BASE_URL=https://your-custom-api.com/v1

# === 服务配置 ===
HOST=0.0.0.0
PORT=8000

# === 数据存储 ===
EXPERIENCE_PATH=./data/experiences.json

# === 日志级别 ===
LOG_LEVEL=info

# === 模型使用建议 ===
# 
# 编程/代码任务首选：
#   - Claude 3.5 Sonnet (综合能力最强)
#   - DeepSeek Coder (性价比最高)
#   - GPT-4o (速度快效果稳)
#   - 通义千问 Coder (中文支持好)
#   - Mistral Codestral (欧洲最强代码模型)
#
# 通用复杂任务：
#   - GPT-4o (最均衡)
#   - Claude 3 Opus (长文本最强)
#   - Gemini 1.5 Pro (多模态最强)
#
# 中文任务首选：
#   - DeepSeek V3 (便宜好用)
#   - Kimi (长文档处理强)
#   - 通义千问 Max (阿里系最强)
#   - 智谱 GLM-4 (免费额度多)
#
# 开源模型：
#   - Meta Llama 3.1 405B (开源最强)
#   - Mistral Large (欧洲最强)
#
# 预算有限：
#   - DeepSeek V3 (约 GPT-4 1/20 价格)
#   - Gemini 1.5 Flash (Google 低价高速)
#   - GPT-3.5 Turbo (OpenAI 入门款)
#   - 智谱 GLM-4 Flash (免费)
#
# 无需 API Key：
#   - Simple 本地规则引擎

# 配置说明：
# 1. 不需要配置所有模型，只需要配置你想使用的模型
# 2. 如果配置了多个模型，可以在前端界面中切换
# 3. 如果某个模型配置错误或未配置，会自动回退到本地规则引擎
# 4. 自定义API需要同时设置 CUSTOM_API_KEY 和 CUSTOM_BASE_URL
# 5. 百度文心一言需要同时配置 ERNIE_API_KEY 和 ERNIE_SECRET_KEY

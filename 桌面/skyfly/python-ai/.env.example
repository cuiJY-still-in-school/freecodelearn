# SkyFly AI Service Configuration
# 复制此文件为 .env 并填入你的API密钥

# === OpenAI ===
OPENAI_API_KEY=your_openai_api_key_here
DEFAULT_MODEL=gpt-4

# === DeepSeek ===
# 获取API Key: https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# === Kimi (Moonshot AI) ===
# 获取API Key: https://platform.moonshot.cn/
KIMI_API_KEY=your_kimi_api_key_here

# === 自定义API ===
# 支持任何兼容OpenAI API格式的服务
CUSTOM_API_KEY=your_custom_api_key_here
CUSTOM_BASE_URL=https://your-custom-api.com/v1

# === 服务配置 ===
HOST=0.0.0.0
PORT=8000

# === 数据存储 ===
EXPERIENCE_PATH=./data/experiences.json

# === 日志级别 ===
LOG_LEVEL=info

# 配置说明：
# 1. 不需要配置所有模型，只需要配置你想使用的模型
# 2. 如果配置了多个模型，可以在前端界面中切换
# 3. 如果某个模型配置错误或未配置，会自动回退到本地规则引擎
# 4. 自定义API需要同时设置 CUSTOM_API_KEY 和 CUSTOM_BASE_URL

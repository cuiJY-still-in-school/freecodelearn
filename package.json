{
  "name": "freecodelearn",
  "version": "1.3.2",
  "private": true,
  "description": "AI 生成编程课程 - 输入主题,几分钟获得一门 freeCodeCamp 风格的完整课程",
  "author": "FreeCodeLearn",
  "homepage": "https://github.com/",
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "electron:dev": "electron .",
    "electron:server": "bash scripts/package-server.sh",
    "electron:linux": "bash scripts/package-server.sh && electron-builder --linux",
    "electron:win": "bash scripts/package-server.sh && electron-builder --win",
    "electron:mac": "bash scripts/package-server.sh && electron-builder --mac"
  },
  "build": {
    "appId": "com.freecodelearn.app",
    "productName": "FreeCodeLearn",
    "afterPack": "scripts/inject-server.js",
    "files": [
      "electron/**",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "electron/icon.png",
      "category": "Education",
      "maintainer": "FreeCodeLearn"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "electron/icon.png"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "electron/icon.png",
      "category": "public.app-category.education"
    }
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@uiw/react-codemirror": "^4.25.11",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
